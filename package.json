{
  "name": "the-signal-brief",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"node --use-env-proxy --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --use-env-proxy server/index.mjs",
    "preview": "npm start",
    "test": "node --test server/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src server shared tests *.mjs *.ts *.json README.md .github/workflows/*.yml",
    "format:check": "prettier --check src server shared tests *.mjs *.ts *.json README.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "express": "5.3.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rss-parser": "3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
